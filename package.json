{
  "name": "synapse-router",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packs/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter @synapse-router/docs build:site",
    "dev": "pnpm --filter @synapse-router/api dev",
    "test": "pnpm -r --if-present test",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
