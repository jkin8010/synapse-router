{
  "agent_id": "openai-dalle",
  "agent_name": "OpenAI DALL-E",
  "version": "1.0.0",
  "access_protocol": {
    "kind": "api",
    "auth_type": "Bearer"
  },
  "features": [
    {
      "feature_id": "images_generations_post_v1_images_generations",
      "feature_name": "Image Generations",
      "intent": "text-to-image",
      "input_schema": {
        "name": "ImageGenerationInput",
        "fields": [
          { "name": "prompt", "type": "string", "required": true, "description": "Text description of the desired image" },
          { "name": "model", "type": "string", "required": false, "description": "Model identifier e.g. dall-e-3, dall-e-2" },
          { "name": "n", "type": "number", "required": false, "description": "Number of images to generate" },
          { "name": "quality", "type": "string", "required": false, "enum": ["standard", "hd"], "description": "Image quality" },
          { "name": "response_format", "type": "string", "required": false, "enum": ["url", "b64_json"], "description": "Output format" },
          { "name": "size", "type": "string", "required": false, "enum": ["1024x1024", "1792x1024", "1024x1792", "256x256", "512x512"], "description": "Image dimensions" }
        ]
      },
      "output_schema": {
        "name": "ImageGenerationOutput",
        "fields": [
          { "name": "created", "type": "number" },
          { "name": "data", "type": "array" }
        ]
      },
      "field_mappings": [
        { "canonical_field": "prompt", "provider_field": "prompt", "required": true },
        { "canonical_field": "model", "provider_field": "model", "required": false },
        { "canonical_field": "n", "provider_field": "n", "required": false, "fallback": 1 },
        { "canonical_field": "quality", "provider_field": "quality", "required": false },
        { "canonical_field": "response_format", "provider_field": "response_format", "required": false },
        { "canonical_field": "size", "provider_field": "size", "required": false }
      ],
      "capabilities": [
        { "kind": "image-generation", "modalities": ["image"] }
      ]
    }
  ]
}
