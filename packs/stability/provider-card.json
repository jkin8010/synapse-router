{
  "provider": {
    "id": "stability",
    "name": "Stability AI",
    "version": "1.0.0",
    "api_version": "2024-01-01",
    "base_url": "https://api.stability.ai/v1",
    "auth_type": "APIKey",
    "docs_url": "https://platform.stability.ai/docs/api"
  },
  "features": [
    {
      "id": "text_to_image_post_v1_generation_text2img",
      "intent": "text-to-image",
      "name": "Text to Image",
      "description": "Generate images from text prompts using Stable Diffusion",
      "input": {
        "name": "TextToImageInput",
        "fields": [
          { "name": "text_prompts", "type": "array", "required": true, "description": "Array of text prompts with weight" },
          { "name": "width", "type": "number", "required": false },
          { "name": "height", "type": "number", "required": false },
          { "name": "samples", "type": "number", "required": false },
          { "name": "steps", "type": "number", "required": false },
          { "name": "seed", "type": "number", "required": false },
          { "name": "cfg_scale", "type": "number", "required": false },
          { "name": "model", "type": "string", "required": false }
        ]
      },
      "output": {
        "name": "TextToImageOutput",
        "fields": [
          { "name": "artifacts", "type": "array" },
          { "name": "finish_reasons", "type": "array" }
        ]
      },
      "field_mappings": [
        { "canonical_field": "prompt", "provider_field": "text_prompts", "required": true },
        { "canonical_field": "width", "provider_field": "width", "required": false },
        { "canonical_field": "height", "provider_field": "height", "required": false },
        { "canonical_field": "samples", "provider_field": "samples", "required": false, "fallback": 1 },
        { "canonical_field": "steps", "provider_field": "steps", "required": false },
        { "canonical_field": "seed", "provider_field": "seed", "required": false },
        { "canonical_field": "cfg_scale", "provider_field": "cfg_scale", "required": false },
        { "canonical_field": "model", "provider_field": "model", "required": false }
      ],
      "pricing": { "input": 0.0, "output": 0.04, "unit": "per image" },
      "limits": { "rpm": 10 }
    },
    {
      "id": "image_to_image_post_v1_generation_img2img",
      "intent": "image-to-image",
      "name": "Image to Image",
      "description": "Transform existing images using Stable Diffusion",
      "input": {
        "name": "ImageToImageInput",
        "fields": [
          { "name": "text_prompts", "type": "array", "required": true, "description": "Array of text prompts with weight" },
          { "name": "init_image", "type": "string", "required": true, "description": "Base64 encoded init image" },
          { "name": "init_image_mode", "type": "string", "required": false, "enum": ["image_strength", "step_count"] },
          { "name": "image_strength", "type": "number", "required": false },
          { "name": "width", "type": "number", "required": false },
          { "name": "height", "type": "number", "required": false },
          { "name": "samples", "type": "number", "required": false },
          { "name": "steps", "type": "number", "required": false },
          { "name": "seed", "type": "number", "required": false },
          { "name": "cfg_scale", "type": "number", "required": false }
        ]
      },
      "output": {
        "name": "ImageToImageOutput",
        "fields": [
          { "name": "artifacts", "type": "array" },
          { "name": "finish_reasons", "type": "array" }
        ]
      },
      "field_mappings": [
        { "canonical_field": "prompt", "provider_field": "text_prompts", "required": true },
        { "canonical_field": "source_image", "provider_field": "init_image", "required": true, "transform": "base64_decode" },
        { "canonical_field": "init_image_mode", "provider_field": "init_image_mode", "required": false },
        { "canonical_field": "image_strength", "provider_field": "image_strength", "required": false },
        { "canonical_field": "width", "provider_field": "width", "required": false },
        { "canonical_field": "height", "provider_field": "height", "required": false },
        { "canonical_field": "samples", "provider_field": "samples", "required": false, "fallback": 1 },
        { "canonical_field": "steps", "provider_field": "steps", "required": false },
        { "canonical_field": "seed", "provider_field": "seed", "required": false },
        { "canonical_field": "cfg_scale", "provider_field": "cfg_scale", "required": false }
      ],
      "pricing": { "input": 0.0, "output": 0.04, "unit": "per image" },
      "limits": { "rpm": 10 }
    }
  ]
}
