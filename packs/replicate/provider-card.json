{
  "provider": {
    "id": "replicate",
    "name": "Replicate",
    "version": "1.0.0",
    "api_version": "2024-01-01",
    "base_url": "https://api.replicate.com/v1",
    "auth_type": "Bearer",
    "docs_url": "https://replicate.com/docs"
  },
  "features": [
    {
      "id": "predictions_post_v1_predictions",
      "intent": "inference",
      "name": "Predictions",
      "description": "Run machine learning model predictions",
      "input": {
        "name": "PredictionInput",
        "fields": [
          { "name": "version", "type": "string", "required": true, "description": "Model version ID" },
          { "name": "input", "type": "object", "required": true, "description": "Model input parameters" }
        ]
      },
      "output": {
        "name": "PredictionOutput",
        "fields": [
          { "name": "id", "type": "string" },
          { "name": "status", "type": "string" },
          { "name": "output", "type": "object" },
          { "name": "error", "type": "string" },
          { "name": "logs", "type": "string" }
        ]
      },
      "field_mappings": [
        { "canonical_field": "model_version", "provider_field": "version", "required": true },
        { "canonical_field": "input", "provider_field": "input", "required": true }
      ],
      "limits": { "rpm": 60 }
    },
    {
      "id": "trainings_post_v1_trainings",
      "intent": "fine-tuning",
      "name": "Trainings",
      "description": "Fine-tune machine learning models",
      "input": {
        "name": "TrainingInput",
        "fields": [
          { "name": "version", "type": "string", "required": true, "description": "Base model version ID" },
          { "name": "input", "type": "object", "required": true, "description": "Training input parameters" },
          { "name": "trainer", "type": "string", "required": false, "description": "Trainer type" }
        ]
      },
      "output": {
        "name": "TrainingOutput",
        "fields": [
          { "name": "id", "type": "string" },
          { "name": "status", "type": "string" },
          { "name": "output", "type": "object" },
          { "name": "metrics", "type": "object" }
        ]
      },
      "field_mappings": [
        { "canonical_field": "model_version", "provider_field": "version", "required": true },
        { "canonical_field": "input", "provider_field": "input", "required": true },
        { "canonical_field": "trainer", "provider_field": "trainer", "required": false }
      ],
      "limits": { "rpm": 30 }
    }
  ]
}
