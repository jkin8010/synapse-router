# ─── Synapse Router ────────────────────────────────────────────────────────────
# Copy this file to .env and customize for your environment.

# Registry
# Base URL of the Synapse Registry API (default: https://registry.synapse-router.com)
SYNAPSE_REGISTRY_URL=https://registry.synapse-router.com

# Auth token for private Registry access (optional)
# SYNAPSE_REGISTRY_TOKEN=

# API Server
# Port for the HTTP API server (default: 3000)
# PORT=3000
